# Variables de entorno (backend, Fly.io)
# Copia este archivo a .env y rellena los valores según tu entorno.
# En producción (Fly.io) los secrets se configuran con `flyctl secrets set`:
#   flyctl secrets set JWT_SECRET=... OFFICE_PIN=... PGHOST=... PGPASSWORD=...
#
# PostgreSQL (Neon) — si no se definen, el server usa el JSON store local.
PGHOST=
PGUSER=neondb_owner
PGPASSWORD=
PGDATABASE=neondb
PGPORT=5432
PGSSLMODE=require

# Autenticación (obligatorio en producción: la API no arranca sin ellos)
JWT_SECRET=
OFFICE_PIN=

# CORS: orígenes permitidos (separados por coma)
CORS_ORIGINS=https://kavanasystemsinfo-ui.github.io,https://routeai.kavanasystems.com,https://www.routeai.kavanasystems.com

# Opcional: SMTP para email de bienvenida al repartidor
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@routeai.kavanasystems.com

# Opcional: asistente técnico (RAG sobre la documentación)
OPENROUTER_API_KEY=
ASSISTANT_MODEL_FREE=poolside/laguna-s-2.1:free
ASSISTANT_MODEL_PRO=poolside/laguna-s-2.1:free
